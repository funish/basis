{
  "name": "@funish/basis",
  "version": "0.3.0",
  "description": "Release workflow companion for Vite+ — versioning, publishing, commit validation, and stub mode.",
  "keywords": [
    "basis",
    "c12",
    "citty",
    "cli",
    "commit-lint",
    "consola",
    "developer-experience",
    "development-toolkit",
    "javascript",
    "npm-publish",
    "semantic-versioning",
    "semver",
    "stub",
    "typescript",
    "version-management",
    "vite-plus"
  ],
  "homepage": "https://github.com/funish/basis#readme",
  "bugs": {
    "url": "https://github.com/funish/basis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Funish",
    "email": "official@funish.net",
    "url": "https://funish.net/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funish/basis.git",
    "directory": "packages/basis"
  },
  "bin": {
    "basis": "dist/cli/basis.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./cli/*": {
      "types": "./dist/cli/*.d.mts",
      "import": "./dist/cli/*.mjs"
    },
    "./commands/*": {
      "types": "./dist/commands/*.d.mts",
      "import": "./dist/commands/*.mjs"
    }
  },
  "scripts": {
    "dev": "jiti src/cli/basis.ts build --stub",
    "build": "vp pack",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@funish/build": "workspace:*",
    "c12": "4.0.0-beta.5",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "defu": "6.1.7",
    "execa": "9.6.1",
    "jiti": "2.7.0",
    "nypm": "0.6.6",
    "pathe": "2.0.3",
    "pkg-types": "2.3.1",
    "semver": "7.8.0",
    "tinyglobby": "0.2.16"
  },
  "devDependencies": {
    "@types/semver": "7.7.1"
  }
}
